@model List<MetroRailManagementSystem.Models.Train>

@{
    ViewData["Title"] = "Trains";
}

<h2>Trains</h2>

@if (User.IsInRole("Admin"))
{
    <a class="btn btn-success mb-3" asp-action="Create">+ Add Train</a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Total Seats</th>
            <th>Available Seats</th>
            <th>Status</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.TotalSeats</td>
                <td>@t.AvailableSeats</td>
                <td>@(t.IsActive ? "Active" : "Inactive")</td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

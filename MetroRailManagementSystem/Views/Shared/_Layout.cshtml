@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetroRailManagementSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MetroRailManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">MetroRailManagementSystem</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav ms-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Stations" asp-action="Index">Stations</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Trains" asp-action="Index">Trains</a>
                        </li>

                        <!-- Everyone can book tickets -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Tickets" asp-action="Index">Tickets</a>
                        </li>

                        <li class="nav-item">
                            <span class="nav-link @(User.IsInRole("Admin") ? "text-primary fw-semibold" : "text-success fw-semibold")">
                                @(User.IsInRole("Admin") ? "Admin" : "User")
                            </span>
                        </li>

                        <li class="nav-item">
                            <span class="nav-link text-dark">Hello, @User.Identity?.Name</span>
                        </li>

                        <li class="nav-item">
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm mt-1">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                Sign in
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Identity/Account/Login">Login</a></li>
                                <li><a class="dropdown-item" href="/Identity/Account/Register">Registration</a></li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<<main role="main" class="container pb-3">
    <div class="page-card">
        @RenderBody()
    </div>
</main>


<footer class="border-top bg-white">
    <div class="container d-flex justify-content-center align-items-center" style="height:56px;">
        <span class="text-dark small">Metro Rail Management System © 2025</span>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@RenderSection("Scripts", required: false)
</body>
</html>

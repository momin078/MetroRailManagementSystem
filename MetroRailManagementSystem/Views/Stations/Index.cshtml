@model List<MetroRailManagementSystem.Models.Station>

@{
    ViewData["Title"] = "Stations";
}

<h2>Stations</h2>

@if (User.IsInRole("Admin"))
{
    <a class="btn btn-success mb-3" asp-action="Create">+ Add Station</a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Status</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Code</td>
                <td>@(s.IsActive ? "Active" : "Inactive")</td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
